# Environment variables.
# Pro lokální vývoj: zkopírujte na .env.local
# Pro produkci: nastavte v Vercel dashboardu (Project Settings -> Environment Variables).

# Sdílené heslo pro vstup do aplikace (vlastní login).
# Pokud necháte prázdné, aplikace běží v "open" režimu (bez hesla) — VHODNÉ POUZE
# pro lokální vývoj. Pro produkci VŽDY nastavte silné heslo (16+ znaků).
APP_PASSWORD=

# Pokud "true", API vrací v chybové odpovědi i Python traceback.
# DOPORUČENO: ponechat false v produkci, true jen pro lokální debug.
DEBUG_MODE=false
